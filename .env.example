# ──────────────────────────────────────────────────────────────────────────────
# P.A.C.E. Environment Variables — Example
# Copy this file to .env.local for local development.
# .env.local is gitignored and must never be committed.
# ──────────────────────────────────────────────────────────────────────────────

# Resend (email service — already configured in Netlify)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BUSINESS_EMAIL=admin@powerautomotive.ca
FROM_EMAIL=noreply@powerautomotive.ca
FROM_NAME=P.A.C.E. Auto Repair

# Supabase — Frontend (safe to expose, protected by Row Level Security)
# Use the publishable/anon key ONLY. Never use a service role key here.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Supabase — Server-side only (Netlify Functions only — never in src/)
# Both vars below are for server-side use inside netlify/functions/.
# SUPABASE_URL is the same project URL as VITE_SUPABASE_URL but without
# the VITE_ prefix so Netlify Functions can read it at runtime.
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS — never expose in frontend code.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Site URL — used to generate approval/payment links in Netlify Functions
SITE_URL=https://powerautomotive.ca

# Helcim — Server-side only (Netlify Functions only — never in src/)
# Phase 9C: API token for creating invoices via Helcim REST API
# Phase 9D: Webhook secret for verifying Helcim payment event signatures
HELCIM_API_TOKEN=your_helcim_api_token
HELCIM_API_BASE_URL=https://api.helcim.com
# Phase 9D: verifier token from Helcim dashboard → All Tools → Integrations → Webhooks
# This is used to verify the HMAC-SHA256 signature on incoming webhook events.
# It is NOT the same as HELCIM_API_TOKEN.
HELCIM_WEBHOOK_VERIFIER_TOKEN=your_helcim_webhook_verifier_token

# ── Portal PIN Login (Phase 17B) ──────────────────────────────────────────────
# Used by netlify/functions/portal-pin-login.js — SERVER-SIDE ONLY.
# These values must NEVER appear in src/ or any frontend code.
#
# PORTAL_LOGIN_PIN_HASH — SHA-256 hex digest of "${PORTAL_LOGIN_PIN_SALT}:${pin}".
#                         The raw PIN is NOT stored — only this hash.
#                         Generate with:
#                           node -e "
#                             const c=require('crypto'), pin='YOUR_PIN', salt='YOUR_SALT';
#                             console.log(c.createHash('sha256').update(\`\${salt}:\${pin}\`).digest('hex'));
#                           "
# PORTAL_LOGIN_PIN_SALT — A random string used to salt the PIN hash.
#                         Any random string works (e.g. openssl rand -hex 16).
#                         Change the salt if you ever change the PIN.
# PORTAL_ADMIN_EMAIL    — Supabase Auth email for the staff account.
# PORTAL_ADMIN_PASSWORD — Supabase Auth password for the staff account.
#                         Staff never type this — they type the PIN instead.
#                         The function exchanges PIN hash → password server-side.
# SUPABASE_ANON_KEY     — Same value as VITE_SUPABASE_ANON_KEY but without the
#                         VITE_ prefix so Netlify Functions can read it at runtime.
#                         The anon key is safe to use for auth sign-in (it is the
#                         public/publishable key). Do NOT use the service role key here.
PORTAL_LOGIN_PIN_HASH=
PORTAL_LOGIN_PIN_SALT=
PORTAL_ADMIN_EMAIL=
PORTAL_ADMIN_PASSWORD=
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
