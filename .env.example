# ──────────────────────────────────────────────────────────────────────────────
# P.A.C.E. Environment Variables — Example
# Copy this file to .env.local for local development.
# .env.local is gitignored and must never be committed.
# ──────────────────────────────────────────────────────────────────────────────

# Resend (email service — already configured in Netlify)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BUSINESS_EMAIL=admin@powerautomotive.ca
FROM_EMAIL=noreply@powerautomotive.ca
FROM_NAME=P.A.C.E. Auto Repair

# Supabase — Frontend (safe to expose, protected by Row Level Security)
# Use the publishable/anon key ONLY. Never use a service role key here.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# Supabase — Server-side only (Netlify Functions only — never in src/)
# Both vars below are for server-side use inside netlify/functions/.
# SUPABASE_URL is the same project URL as VITE_SUPABASE_URL but without
# the VITE_ prefix so Netlify Functions can read it at runtime.
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS — never expose in frontend code.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
