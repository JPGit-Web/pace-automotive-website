# ──────────────────────────────────────────────────────────────
# P.A.C.E. — Environment Variables
# Copy this file to .env (at the project root) for local dev.
# In Netlify: add these under Site → Environment Variables.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# Resend API key — get yours at https://resend.com
# Create a free account, verify your domain, then copy the key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The email address that receives new appointment requests.
# This should be your verified business email on Resend.
BUSINESS_EMAIL=admin@powerautomotive.ca

# The "from" address shown on outbound emails.
# Must be a verified sender domain in your Resend account.
# Example: noreply@powerautomotive.ca  OR  bookings@powerautomotive.ca
FROM_EMAIL=noreply@powerautomotive.ca

# Display name shown in the "From" field
FROM_NAME=P.A.C.E. Auto Repair
